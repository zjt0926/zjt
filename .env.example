# Token (JWT) signing key (REQUIRED). The app refuses to start if this is
# missing or empty. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Token (JWT) expiration in hours. Defaults to 24 if unset.
# TOKEN_EXPIRES_HOURS=24

# ---- External LLM for the problem-solving assistant ----
# Any OpenAI-compatible Chat Completions endpoint. Leave unset to get a
# clear "AI not configured" error from /api/conversations/<id>/ask.
#
# DeepSeek (paid, very cheap):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-your-deepseek-key
#
# SiliconFlow free models (example):
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3
# LLM_API_KEY=sk-your-siliconflow-key
#
# LLM_TIMEOUT=60

# ---- Self-hosted MCP server ----
# Shared between the mcp-server service (validates inbound requests) and
# the CampusClaw app (sends it when calling tools/call). Generate a strong
# random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(24))"
# This token is ONLY ever stored server-side; it must never reach the
# browser, the Git history, or any Docker image layer.
MCP_AUTH_TOKEN=replace-with-a-strong-random-token

# Optional overrides (defaults shown).
# DATABASE_PATH=/app/data/app.db
# UPLOAD_FOLDER=/app/uploads
